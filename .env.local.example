# Optional local build proxy. Copy this file to .env.local and adjust as needed.
# .env.local is ignored by Git and is not present in CI.
HTTP_PROXY=http://127.0.0.1:9890
HTTPS_PROXY=http://127.0.0.1:9890
http_proxy=http://127.0.0.1:9890
https_proxy=http://127.0.0.1:9890
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1
